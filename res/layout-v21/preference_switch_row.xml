<?xml version="1.0" encoding="utf-8"?>
<!--
    Clean Material preference row for a single SwitchPreference, bound directly via
    android:layout on that preference (see res/layout-v21/testsuite_fragment.xml,
    linpack_use_all_cpus). Unlike the shared res/layout-v21/preference_switch_card.xml,
    this row has no full-height divider before the switch and no fixed-width widget
    column, avoiding the large empty area and rigid vertical split that produces on a
    single-row Test Suite screen. Other API-21 preference screens keep using the
    shared preference_switch_card.xml and are not affected by this file.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="?attr/aeroCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/listPreferredItemHeight"
        android:gravity="center_vertical"
        android:clipToPadding="false">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="56dp"/>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@android:id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:textSize="18sp"
                android:textColor="?attr/aeroPrimaryTextColor"/>
            <TextView
                android:id="@android:id/summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@android:id/title"
                android:layout_alignStart="@android:id/title"
                android:textSize="14sp"
                android:textColor="?attr/aeroSecondaryTextColor"
                android:maxLines="4"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@android:id/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingEnd="8dp"/>
    </LinearLayout>
</FrameLayout>