<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <SeekBar
        android:id="@+id/redValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/redValue"
        android:max="255"
        android:progressTint="@color/gpu_slider_red"
        android:thumbTint="@color/gpu_slider_red"/>
    <EditText
        android:id="@+id/redValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
    <SeekBar
        android:id="@+id/greenValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/greenValue"
        android:layout_below="@+id/redValues"
        android:max="255"
        android:progressTint="@color/gpu_slider_green"
        android:thumbTint="@color/gpu_slider_green"/>
    <EditText
        android:id="@+id/greenValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/redValue"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
    <SeekBar
        android:id="@+id/blueValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/blueValue"
        android:layout_below="@+id/greenValues"
        android:max="255"
        android:progressTint="@color/gpu_slider_blue"
        android:thumbTint="@color/gpu_slider_blue"/>
    <EditText
        android:id="@+id/blueValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/greenValue"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
</RelativeLayout>