<?xml version="1.0" encoding="utf-8"?>
<!--
    Container for a single settings category. Used only by SettingsCardAdapter
    to render each PreferenceCategory (header + child preference rows) inside
    one shared Material card surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    style="?attr/aeroCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clipToPadding="false"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/settings_card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textColor="?android:attr/colorAccent"/>

    <LinearLayout
        android:id="@+id/settings_card_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

</LinearLayout>