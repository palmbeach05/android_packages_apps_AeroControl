<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-card row for ListPreference entries. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeight"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/settings_list_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="56dp" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/settings_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:textSize="18sp"
            android:textColor="?attr/aeroPrimaryTextColor" />

        <TextView
            android:id="@+id/settings_list_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/settings_list_title"
            android:layout_alignStart="@id/settings_list_title"
            android:maxLines="4"
            android:textSize="14sp"
            android:textColor="?attr/aeroSecondaryTextColor" />
    </RelativeLayout>
</LinearLayout>