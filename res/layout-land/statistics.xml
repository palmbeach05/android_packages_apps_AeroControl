<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textColor="?attr/aeroPrimaryTextColor"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/noCpuData"
        android:padding="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_cpu_data"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/statisticGraphContainer"
        android:layout_width="220dp"
        android:layout_height="240dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <com.echo.holographlibrary.PieGraph
            android:id="@+id/graph"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="26sp"
            android:gravity="center"
            android:id="@+id/statisticFreq"
            android:layout_width="124dp"
            android:layout_height="40dp"
            android:layout_marginTop="65dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/statisticTime"
            android:layout_width="144dp"
            android:layout_height="30dp"
            android:layout_marginTop="105dp"
            android:layout_centerHorizontal="true"
            style="?android:attr/textAppearanceLarge"/>
        <TextView
            android:textSize="42sp"
            android:gravity="center"
            android:id="@+id/statisticPercentage"
            android:layout_width="124dp"
            android:layout_height="45dp"
            android:layout_marginTop="130dp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ListView
        android:id="@+id/statisticListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/statisticGraphContainer"
        android:drawSelectorOnTop="true"
        android:listSelector="?android:attr/selectableItemBackground"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"/>
</RelativeLayout>