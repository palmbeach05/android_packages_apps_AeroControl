<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
    </style>
    <style name="Theme.Transparent" parent="@android:style/Theme.Material.Light.NoActionBar">
    </style>
    <style name="AeroTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:listViewWhiteStyle">@style/ListViewAeroTheme.White</item>
        <item name="android:actionBarStyle">@style/AeroActionBar</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background_holo_light</item>
        <item name="android:actionMenuTextColor">@android:color/white</item>
    </style>
    <style name="AeroTheme.Dark" parent="@android:style/Theme.Material">
        <item name="android:actionBarStyle">@style/AeroActionBar.Dark</item>
        <item name="android:activatedBackgroundIndicator">@drawable/activated_background_holo_light</item>
        <item name="android:actionMenuTextColor">@android:color/white</item>
        <item name="android:windowBackground">@color/dark_window_background</item>
        <item name="android:textColorPrimary">@color/dark_text_color</item>
    </style>
</resources>
