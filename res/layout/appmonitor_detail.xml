<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fab="http://schemas.android.com/apk/res/com.aero.control"
    android:orientation="horizontal"
    android:background="?attr/aeroDrawerLayoutBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topLevel"
        android:background="@drawable/actionbar_card"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/usageTimer"
                android:paddingLeft="17dp"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Switch
                android:id="@+id/switch1"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/topValue"
                android:paddingLeft="16dp"
                android:paddingTop="20dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/reset_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_alignParentRight="true"
                    fab:fab_colorPressed="#c62828"
                    fab:fab_colorNormal="#f44336"
                    fab:fab_icon="@drawable/ic_refresh"
                    fab:fab_title="@string/reload"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <com.db.chart.view.LineChartView
        android:id="@+id/graph"
        android:background="?attr/aeroGraphBackground"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@+id/topLevel"/>
    <HorizontalScrollView
        android:gravity="center"
        android:id="@+id/horizontalscreen"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fillViewport="true"
        android:layout_below="@+id/graph">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layouthorizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
</RelativeLayout>
