<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/light_grey"
        android:id="@+id/random_read"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_alignParentLeft="true"/>
    <EditText
        android:gravity="right"
        android:id="@+id/random_read_value"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/random_read"
        android:inputType="number"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/light_grey"
        android:id="@+id/random_write"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_below="@+id/random_read"
        android:layout_alignParentLeft="true"/>
    <EditText
        android:gravity="right"
        android:id="@+id/random_write_value"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/random_write"
        android:layout_below="@+id/random_read_value"
        android:inputType="number"/>
</RelativeLayout>
