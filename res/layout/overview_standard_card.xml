<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="?attr/aeroCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="6dp"
    android:layout_marginTop="3dp"
    android:layout_marginRight="6dp"
    android:layout_marginBottom="3dp"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/aeroPrimaryTextColor" android:textSize="18sp"/>
    <TextView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="?attr/aeroSecondaryTextColor" android:textSize="14sp"/>
</LinearLayout>
