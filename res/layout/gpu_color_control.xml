<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:materialdesign="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.aero.control.helpers.Android.Material.Slider
        android:id="@+id/redValues"
        android:background="@color/gpu_slider_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/redValue"
        materialdesign:showNumberIndicator="true"
        materialdesign:max="255"
        materialdesign:min="20"/>
    <EditText
        android:id="@+id/redValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
    <com.aero.control.helpers.Android.Material.Slider
        android:id="@+id/greenValues"
        android:background="@color/gpu_slider_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/greenValue"
        android:layout_below="@+id/redValues"
        materialdesign:showNumberIndicator="true"
        materialdesign:max="255"
        materialdesign:min="20"/>
    <EditText
        android:id="@+id/greenValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/redValue"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
    <com.aero.control.helpers.Android.Material.Slider
        android:id="@+id/blueValues"
        android:background="@color/gpu_slider_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@+id/blueValue"
        android:layout_below="@+id/greenValues"
        materialdesign:showNumberIndicator="true"
        materialdesign:max="255"
        materialdesign:min="20"/>
    <EditText
        android:id="@+id/blueValue"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:layout_below="@+id/greenValue"
        android:layout_alignParentRight="true"
        android:inputType="number"/>
</RelativeLayout>
