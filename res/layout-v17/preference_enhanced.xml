<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    style="?attr/aeroCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeight">
    <com.aero.control.helpers.Android.Material.CustomImageButton
        android:id="@+id/info_button"
        android:background="@drawable/background_transparent"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/info"
        android:paddingEnd="10dp"/>
    <View
        android:id="@+id/separator_info"
        android:background="?attr/aeroDividerColor"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="2dp"
        android:minWidth="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/aeroPrimaryTextColor"
            android:ellipsize="marquee"
            android:id="@+id/preference_title"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/aeroSecondaryTextColor"
            android:id="@+id/preference_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:maxLines="4"/>
    </RelativeLayout>
    <View
        android:id="@+id/separator_checkbox"
        android:background="?attr/aeroDividerColor"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <android.widget.CheckBox
        android:id="@+id/checkbox_pref"
        android:background="?attr/aeroPreferenceControlBackground"
        android:paddingLeft="0dp"
        android:paddingRight="5dp"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:paddingEnd="5dp"/>
</LinearLayout>
